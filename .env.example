# ============================================
# Stock Market Analysis - Variables de Entorno
# ============================================
# Copia este archivo a .env y configura tus valores
# cp .env.example .env

# ============================================
# CONFIGURACIÓN DE TELEGRAM (Alertas)
# ============================================
# Token del bot de Telegram (obtener de @BotFather)
TELEGRAM_BOT_TOKEN=

# ID del chat para recibir alertas (tu chat ID personal o grupo)
TELEGRAM_CHAT_ID=

# ============================================
# RUTAS DEL PROYECTO (Opcional)
# ============================================
# Dejar vacío para usar valores por defecto
# PROJECT_DIR=/ruta/al/proyecto
# DATA_DIR=/ruta/al/proyecto/data

# Para Airflow:
# STOCK_ANALYSIS_SRC_PATH=/ruta/al/src
# STOCK_ANALYSIS_DATA_PATH=/ruta/al/data

# ============================================
# PERÍODO DE ANÁLISIS
# ============================================
# Número de meses hacia atrás para analizar
# Por defecto: 12 meses
ANALYSIS_MONTHS_BACK=6

# ============================================
# PARÁMETROS DE RSI
# ============================================
# Período para calcular RSI (por defecto: 14)
RSI_PERIOD=14

# Umbral de RSI para considerar sobrevendido (por defecto: 30)
RSI_OVERSOLD_THRESHOLD=30

# Umbral de RSI para considerar sobrecomprado (por defecto: 70)
RSI_OVERBOUGHT_THRESHOLD=70

# ============================================
# UMBRALES DE ALERTAS
# ============================================
# Días de anticipación para alertas de dividendos
DIVIDEND_ALERT_DAYS=7

# Umbral de caída diaria para generar alerta (porcentaje)
DAILY_DROP_THRESHOLD=5.0

# Umbral de rentabilidad prevista para alerta (porcentaje)
EXPECTED_RETURN_THRESHOLD=20.0

# ============================================
# CONFIGURACIÓN DE ANÁLISIS
# ============================================
# Tasa libre de riesgo anualizada para Sharpe Ratio
DEFAULT_RISK_FREE_RATE=0.0

# ============================================
# LOGGING
# ============================================
# Nivel de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Formato de log (opcional)
# LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
